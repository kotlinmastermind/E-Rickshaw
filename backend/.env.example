# ===============================================
# E-Rickshaw Platform Environment Variables Template
# ===============================================
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate_with_openssl_rand_hex_32

# Razorpay Payment Gateway (Live or Test Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere
# Optional previous webhook secret only during active secret-rotation retry window
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Required in production: exact Razorpay Merchant Account ID (e.g. acc_XXXXXXXXXXXXXX)
RAZORPAY_MERCHANT_ACCOUNT_ID=acc_YourMerchantIdHere

# Supabase PostgreSQL Pooler (Transaction Mode Port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://postgres.project:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Upstash Redis
REDIS_URL=rediss://default:token@region.upstash.io:6379

# SMS Gateway (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mapbox
MAPBOX_PUBLIC_TOKEN=pk.eyJxxxxxxxxxxxxxxxxxxxx
MAPBOX_SECRET_TOKEN=sk.eyJxxxxxxxxxxxxxxxxxxxx

# Push Notifications (Firebase Cloud Messaging HTTP v1 ONLY)
PUSH_PROVIDER=fcm
# Provide EITHER raw service-account JSON string OR a local/mounted file path
# FCM_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id"}
