PROJECT_NAME="E-Rickshaw Ride-Hailing Platform"
API_V1_STR=/api/v1
ENVIRONMENT=production
DEBUG=False

# PostgreSQL Database (e.g. Supabase, Render PostgreSQL, or Neon)
# Async driver for FastAPI:
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:5432/<dbname>?ssl=require
# Sync driver for Alembic migrations:
DATABASE_URL_SYNC=postgresql+psycopg2://<username>:<password>@<host>:5432/<dbname>?sslmode=require

# Supabase Project Credentials (if using Supabase)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-supabase-anon-or-service-key>

# Redis (e.g. Upstash Cloud Redis or Render Redis)
REDIS_URL=rediss://default:<password>@<host>:6379

# Security & Authentication
SECRET_KEY=generate-a-strong-random-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_SECONDS=300

# Payments (Razorpay Live or Test Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxx

# Google Maps Platform (Directions, Geocoding & Places Autocomplete API)
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_cloud_server_key

# SMS Provider ("mock", "twilio", or "fast2sms")
SMS_PROVIDER=mock

# Twilio SMS Configuration (Required if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Fast2SMS Configuration (India OTP route, required if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=your_fast2sms_api_key
